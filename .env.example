NODE_ENV=production
PORT=3000
APP_URL=https://crm.supereducarbrasil.com.br

# Banco separado do SR Gestão
POSTGRES_PASSWORD=troque_esta_senha_do_banco
DATABASE_URL=postgresql://crm_meta:troque_esta_senha_do_banco@postgres:5432/crm_meta
DATABASE_SSL=false
RUN_MIGRATIONS_ON_STARTUP=false

# Login inicial
ADMIN_EMAIL=admin@supereducarbrasil.com.br
ADMIN_PASSWORD_HASH=gere-um-hash-scrypt-conforme-o-README
SESSION_SECRET=troque-por-uma-chave-aleatoria-com-64-caracteres
COOKIE_SECURE=true

# Exibe na tela principal somente leads criados a partir deste instante.
# Leads anteriores permanecem armazenados e não são modificados.
OPERATION_START_AT=2026-07-23T00:00:00-03:00

# Meta Graph / Conversions API
META_GRAPH_VERSION=v25.0
# Chave Base64 de 32 bytes usada somente para cifrar credenciais das Conexões Meta.
META_CREDENTIALS_ENCRYPTION_KEY=
META_DATASET_ID=
META_CAPI_ACCESS_TOKEN=
META_PAGE_ACCESS_TOKEN=
META_APP_SECRET=
META_WEBHOOK_VERIFY_TOKEN=troque-por-um-token-de-verificacao
META_LEAD_EVENT_SOURCE=Super Educar CRM

# Teste: deixe true somente enquanto usar "Testar eventos" no Gerenciador de Eventos
META_TEST_MODE=true
META_TEST_EVENT_CODE=

# Identificação da instalação
DEFAULT_TENANT_ID=super-educar

# WA Sender 2 (opcional, somente server-side)
WA2_INTERNAL_API_BASE_URL=https://wa2.supereducarbrasil.com.br
WA2_INTERNAL_API_SECRET=
WA2_INTERNAL_API_TIMEOUT_MS=5000
